<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        纯 Compose 界面，这里只需要一个无 ActionBar 的宿主主题。
        用系统 Material 主题而不是 AppCompat：Activity 继承的是
        ComponentActivity，不依赖 AppCompat 库。
    -->
    <style name="Theme.ADisplayTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>
</resources>
