<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV 播放器控制栏。

    播放相关按钮交给 Media3 的 PlayerControlView 接管；日志与结束投屏是本应用
    自己的动作，由 PlaybackScreen 在 PlayerView 创建后绑定。这样它们属于播放器
    的同一条控制栏，不再另起一列 Compose 悬浮按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#CC101418"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <ImageButton
        android:id="@id/exo_rew"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/player_rewind"
        android:src="@drawable/exo_icon_rewind"
        android:focusable="true" />

    <Button
        android:id="@+id/tv_play_toggle"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginHorizontal="8dp"
        android:contentDescription="@string/player_play"
        android:focusable="true"
        android:minWidth="96dp"
        android:text="@string/player_play"
        android:textAllCaps="false" />

    <ImageButton
        android:id="@id/exo_ffwd"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/player_forward"
        android:src="@drawable/exo_icon_fastforward"
        android:focusable="true" />

    <TextView
        android:id="@id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <!--
        进度条必须**不可聚焦**。

        DefaultTimeBar 在自己的构造函数里 setFocusable(true)，并且在 onKeyDown 里
        吃掉方向键的左右（用来拖动进度）。而这条控制栏是单行横排 —— 焦点一旦落到
        它身上，左右键就变成「拖进度」，再也走不到它右边的「日志 / 结束投屏」，
        遥控器用户等于按不到那两个按钮（2026-10-22 用户报的现象）。

        设成不可聚焦之后：方向键在 rew → 播放 → ffwd → 日志 → 结束投屏 之间正常
        移动；触摸拖动进度条不受影响（focusable 只管焦点，不管触摸）。遥控器要
        快进快退仍可以用两侧的 ±10 秒按钮，手机上的进度条也一直在。
    -->
    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:bar_height="4dp"
        app:touch_target_height="36dp" />

    <TextView
        android:id="@id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <Button
        android:id="@+id/tv_log_button"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:focusable="true"
        android:text="日志"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/tv_end_button"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:focusable="true"
        android:text="结束投屏"
        android:textAllCaps="false" />

</LinearLayout>
