<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- mDNS 收发组播包需要它，少了就永远搜不到设备（文档 4.5）。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 前台服务：接收服务要在应用退到后台之后继续跑（文档 2.3）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 起前台服务要声明类型，类型对应的权限也得申请。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13 起，那条常驻通知要用户允许通知才显示得出来。
         拒绝了不影响接收，只是没有通知。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 电视端开机自启还没做，那是批次 5 的事。 -->

    <!-- 文档 4.5：触屏设为非必需，否则纯遥控器设备在应用商店会被过滤。 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.ethernet"
        android:required="false" />

    <!-- 局域网里的媒体地址是明文 HTTP，Android 9 起默认会被拦掉。
         理由写在 network_security_config.xml 的文件头。
         注意：这条注释只能放在标签**外面** —— XML 不允许注释出现在起始标签的
         属性之间，上一版就是这么挂掉的。 -->
    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ADisplayTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER 是电视桌面上的入口（文档 4.5）。 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            MainActivity 用 adjustResize（见上面 activity 的 windowSoftInputMode）：
            软键盘弹出时窗口跟着收缩，底部的抽屉就自然浮到键盘之上。
            默认的 adjustUnspecified 在这台机器上落到了 adjustPan —— 窗口不缩、
            只把内容整体上推，于是改名抽屉被键盘整个盖住，输入框和保存/取消都
            看不见。adjustResize 是 Compose 里输入框的常规选择。
        -->

        <!--
            接收服务的前台服务外壳：只负责让进程在后台活着（见 ReceiverService）。
            类型取 mediaPlayback —— 本应用做的就是接收媒体流并把它显示出来。

            stopWithTask=false 是从最近任务里划掉应用也**不**停服务，投屏继续。
            这是默认值，写出来是为了表明有意为之，而不是漏配。
        -->
        <service
            android:name=".ReceiverService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
    </application>
</manifest>
