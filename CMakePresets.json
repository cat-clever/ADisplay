{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "本机开发（不启用告警即错误）",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ADISPLAY_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "macos-universal",
      "inherits": "base",
      "displayName": "macOS Universal（Apple Silicon + Intel）",
      "description": "文档 2.5：以 CMAKE_OSX_ARCHITECTURES=\"arm64;x86_64\" 构建通用二进制，不依赖 Rosetta 2。",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-universal",
        "VCPKG_HOST_TRIPLET": "arm64-osx",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "ADISPLAY_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "displayName": "macOS 单架构 arm64（本机开发用，构建更快）",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "ADISPLAY_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "windows-x64",
      "inherits": "base",
      "displayName": "Windows x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "base",
      "displayName": "Windows ARM64（在 x64 上用 vcpkg arm64-windows 三元组交叉编译）",
      "description": "文档 2.5：ARM64 上原生运行，不依赖 x64 转译。",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
      }
    },

    {
      "name": "linux-x64",
      "inherits": "base",
      "displayName": "Linux x64",
      "description": "文档把 Linux 桌面端标为 P2「暂缓」，这里只用于构建核心库并跑单元测试。",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "ADISPLAY_BUILD_TESTS": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "dev",              "configurePreset": "dev" },
    { "name": "macos-universal",  "configurePreset": "macos-universal" },
    { "name": "macos-arm64",      "configurePreset": "macos-arm64" },
    { "name": "windows-x64",      "configurePreset": "windows-x64" },
    { "name": "windows-arm64",    "configurePreset": "windows-arm64" },
    { "name": "linux-x64",        "configurePreset": "linux-x64" }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "dev",             "inherits": "base", "configurePreset": "dev" },
    { "name": "macos-universal", "inherits": "base", "configurePreset": "macos-universal" },
    { "name": "macos-arm64",     "inherits": "base", "configurePreset": "macos-arm64" },
    { "name": "windows-x64",     "inherits": "base", "configurePreset": "windows-x64" },
    { "name": "windows-arm64",   "inherits": "base", "configurePreset": "windows-arm64" },
    { "name": "linux-x64",       "inherits": "base", "configurePreset": "linux-x64" }
  ]
}
