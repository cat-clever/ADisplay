{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "adisplay",
  "version": "0.5.24",
  "description": "跨平台投屏接收端：AirPlay / DLNA 接收，支持 Windows、macOS、Android TV",
  "homepage": "https://github.com/cat-clever/ADisplay",
  "license": "AGPL-3.0-or-later",
  "dependencies": [
    {
      "name": "spdlog",
      "features": [
        "fmt"
      ]
    },
    "fmt",
    "nlohmann-json",
    "tinyxml2",
    "cpp-httplib",
    {
      "name": "openssl",
      "platform": "!android"
    },
    {
      "name": "libplist",
      "platform": "!android"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat"
      ],
      "platform": "!android"
    }
  ],
  "builtin-baseline": "2750401336fb7c95f6619657a46a7e798661341c"
}
