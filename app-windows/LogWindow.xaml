<?xml version="1.0" encoding="utf-8"?>
<!--
    独立的日志窗口。

    单独开一个窗口而不是把日志画在页面里：投屏时画面要占满整个窗口，
    而日志是排查时才看的东西 —— 两者同时需要盯着的场合很少，挤在一起只会
    让画面变小、日志也只有巴掌大。设置页与投屏页各留一个「查看日志」按钮，
    都打开这一个窗口。
-->
<Window
    x:Class="ADisplay.Windows.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="日志" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <!--
                日志每行是独立的 TextBlock（便于虚拟化），代价是只能一行行选。
                贴给别人排查时很不方便，所以给一个一键复制的入口。
            -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="复制全部" Click="OnCopyLogClick" />
                <Button Content="清除日志" Click="OnClearLogClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                CornerRadius="4"
                Padding="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <!--
                    整份日志放在一个 TextBlock 里，而不是每行一个。

                    每行一个便于虚拟化，但鼠标拖不出跨行的选区 —— 想复制中间
                    一段就只能一行一行来，而「把出错前后几行一起贴出去」恰好是
                    看日志的人最常做的事。日志上限 500 行，一次渲染的开销可以
                    接受。
                -->
                <TextBlock x:Name="LogText"
                           IsTextSelectionEnabled="True"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
