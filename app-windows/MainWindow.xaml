<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ADisplay.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ADisplay 投屏接收端">

    <!--
        布局策略：前三块按内容取高（Auto），日志区吃掉剩余空间（*）。
        窗口缩小时先压日志区，而不是把某一块挤出可视区域 —— 后者会让
        用户看不到控件却也不知道为什么。
    -->
    <Grid>

        <!--
            投屏页。手机推来地址时显示，把整个窗口让给画面；停止后回到设置页。
            与 macOS 端同一套行为。
        -->
        <!--
            投屏页：画面满幅，四周不留边距也不留边框。

            投屏时用户看的就是画面，任何一圈留白都是白扔的像素。控制条紧贴在
            画面下方，画面本身仍然被内容包住，不需要额外的框。
        -->
        <Grid x:Name="CastingPanel" Visibility="Collapsed">
            <!-- 全屏时按 Esc 退出。挂在整块投屏面板上，比绑在按钮上精确：
                 绑按钮的话窗口模式下按 Esc 也会进全屏，而用户按 Esc 通常是想
                 关掉某个东西。 -->
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            </Grid.KeyboardAccelerators>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 黑底：画面比例与窗口不一致时，留出来的是黑边而不是主题色的
                 一块，看起来才像播放器。 -->
            <MediaPlayerElement x:Name="PlayerElement"
                                Grid.Row="0"
                                Background="Black"
                                AreTransportControlsEnabled="True"
                                Stretch="Uniform" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        Padding="12,8">
                <TextBlock x:Name="CastingTitleText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button x:Name="ShowLogButton"
                        Content="查看日志"
                        Click="OnShowLogClick" />
                <Button x:Name="FullScreenButton"
                        Content="全屏"
                        Click="OnToggleFullScreenClick" />
                <Button x:Name="StopCastingButton"
                        Content="停止接收"
                        Click="OnStopCastingClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="SettingsPanel" Padding="28" RowSpacing="20" MinWidth="480" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- 设备名称（文档 2.4：可随时修改，手机投屏列表里显示的就是它） -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="设备名称" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DeviceNameBox"
                         Grid.Column="0"
                         MaxLength="32"
                         PlaceholderText="例如：客厅电脑"
                         TextChanged="OnDeviceNameTextChanged" />
                <Button x:Name="ApplyNameButton"
                        Grid.Column="1"
                        Content="保存"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnApplyNameClick" />
            </Grid>
            <TextBlock x:Name="NameHintText"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- 服务开关与状态 -->
        <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock Text="接收服务" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="ServiceToggle"
                              OnContent="已开启"
                              OffContent="已关闭"
                              Toggled="OnServiceToggled" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- 本机信息：电视端待机页也要显示这些（文档 2.3） -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="本机信息" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="局域网地址：" />
                <Run x:Name="AddressRun" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="设备标识：" />
                <Run x:Name="DeviceIdRun" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="核心版本：" />
                <Run x:Name="VersionRun" />
            </TextBlock>
        </StackPanel>

        <!-- 日志不画在页面里，改成一个独立的窗口（见 LogWindow.xaml）。 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <Button x:Name="ShowLogButtonSettings"
                    Content="查看日志"
                    Click="OnShowLogClick" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="日志在单独的窗口里显示，投屏时也能一直开着。" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
