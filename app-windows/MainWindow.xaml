<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ADisplay.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ADisplay 投屏接收端">

    <!--
        布局策略：前三块按内容取高（Auto），日志区吃掉剩余空间（*）。
        窗口缩小时先压日志区，而不是把某一块挤出可视区域 —— 后者会让
        用户看不到控件却也不知道为什么。
    -->
    <Grid>

        <!--
            投屏页。手机推来地址时显示，把整个窗口让给画面；停止后回到设置页。
            与 macOS 端同一套行为。
        -->
        <Grid x:Name="CastingPanel" Visibility="Collapsed" Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 背后的 Media Foundation 负责拉流、硬解与音画同步，
                 传输控制条（播放/暂停、进度、音量、全屏）都是现成的。 -->
            <MediaPlayerElement x:Name="PlayerElement"
                                Grid.Row="0"
                                AreTransportControlsEnabled="True"
                                Stretch="Uniform" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="CastingTitleText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button x:Name="StopCastingButton"
                        Content="停止接收"
                        Click="OnStopCastingClick" />
                <ToggleButton x:Name="CastingLogToggle"
                              Content="显示日志"
                              Checked="OnCastingLogToggled"
                              Unchecked="OnCastingLogToggled" />
            </StackPanel>

            <!--
                投屏页也要能看日志。投屏一失败，设置页连同它的日志区会被整个
                盖住 —— 而那正是最需要看日志的时候。默认收起，不挡画面。
            -->
            <Border x:Name="CastingLogPanel"
                    Grid.Row="2"
                    Height="160"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer x:Name="CastingLogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CastingLogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="SettingsPanel" Padding="28" RowSpacing="20" MinWidth="480" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- 设备名称（文档 2.4：可随时修改，手机投屏列表里显示的就是它） -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="设备名称" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DeviceNameBox"
                         Grid.Column="0"
                         MaxLength="32"
                         PlaceholderText="例如：客厅电脑"
                         TextChanged="OnDeviceNameTextChanged" />
                <Button x:Name="ApplyNameButton"
                        Grid.Column="1"
                        Content="保存"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnApplyNameClick" />
            </Grid>
            <TextBlock x:Name="NameHintText"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- 服务开关与状态 -->
        <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock Text="接收服务" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="ServiceToggle"
                              OnContent="已开启"
                              OffContent="已关闭"
                              Toggled="OnServiceToggled" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- 本机信息：电视端待机页也要显示这些（文档 2.3） -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="本机信息" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="局域网地址：" />
                <Run x:Name="AddressRun" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="设备标识：" />
                <Run x:Name="DeviceIdRun" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="核心版本：" />
                <Run x:Name="VersionRun" />
            </TextBlock>
        </StackPanel>

        <!-- 日志 -->
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Text="日志" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <!--
                    日志区每行是独立的 TextBlock（便于虚拟化），代价是只能
                    一行行选。想贴给别人时很不方便，所以给个一键复制的入口。
                -->
                <Button x:Name="CopyLogButton"
                        Content="复制全部"
                        HorizontalAlignment="Right"
                        Padding="8,2"
                        FontSize="11"
                        Click="OnCopyLogClick" />
            </Grid>
            <Border Grid.Row="1"
                    CornerRadius="4"
                    Padding="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
