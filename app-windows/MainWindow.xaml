<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ADisplay.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ADisplay 投屏接收端">

    <!--
        布局策略：设置项那几块按内容取高（Auto），日志按钮那一行吃掉剩余空间（*）。
        窗口缩小时先压日志行，而不是把某一块挤出可视区域 —— 后者会让
        用户看不到控件却也不知道为什么。
    -->
    <Grid>

        <!--
            投屏页。手机推来地址时显示，把整个窗口让给画面；停止后回到设置页。
            与 macOS 端同一套行为。
        -->
        <!--
            投屏页：画面满幅，四周不留边距也不留边框。

            投屏时用户看的就是画面，任何一圈留白都是白扔的像素。

            控件**浮在画面上**，不占画面的高度 —— 独占一行会把画面压扁一块，
            而那块地方本来该全是画面。
        -->
        <Grid x:Name="CastingPanel" Visibility="Collapsed">
            <!-- 全屏时按 Esc 退出。挂在整块投屏面板上，比绑在按钮上精确：
                 绑按钮的话窗口模式下按 Esc 也会进全屏，而用户按 Esc 通常是想
                 关掉某个东西。 -->
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            </Grid.KeyboardAccelerators>

            <!-- 黑底：画面比例与窗口不一致时，留出来的是黑边而不是主题色的
                 一块，看起来才像播放器。Stretch=Uniform 是按屏幕适应：整幅可见，
                 多出来的边留黑。
                  注意不要写注释在标签属性之间 —— xml 解析会直接失败。 -->
            <MediaPlayerElement x:Name="PlayerElement"
                                Background="Black"
                                AreTransportControlsEnabled="True"
                                Stretch="Uniform" />

            <!--
                悬浮控件：盖在画面上，不占画面高度。

                默认整块收起，鼠标在窗口里一动（以及刚进投屏时）才显示，几秒后
                自动收起 —— 逻辑在 MainWindow.xaml.cs 的 ShowCastingControls。

                中间一行刻意留空且不给背景：空处不参与命中判定，点击照旧落到下面
                的播放器上，它自带的传输控件与进度条还能用。
            -->
            <Grid x:Name="CastingOverlay" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            Padding="16,10"
                            Background="#99000000">
                    <TextBlock x:Name="CastingTitleText"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#CCFFFFFF"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="移动鼠标可再显示控件" />
                </StackPanel>

                <Grid Grid.Row="2" Padding="16,12" Background="#99000000">
                    <StackPanel x:Name="ControlBar"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center">
                        <Button x:Name="ShowLogButton"
                                Content="查看日志"
                                Click="OnShowLogClick" />
                        <Button x:Name="FullScreenButton"
                                Content="全屏"
                                Click="OnToggleFullScreenClick" />
                        <Button x:Name="StopCastingButton"
                                Content="停止接收"
                                Click="OnStopCastingClick" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!--
                缓冲提示。只在缓冲时出现（见 MainWindow.xaml.cs 的 OnBufferingTick）——
                大码率的片子起播前要拉一大段，那段时间画面是黑的，不给点提示
                用户会以为「投屏没反应」。
            -->
            <Border x:Name="BufferingBadge"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Padding="22,14"
                    Background="#9E000000">
                <TextBlock x:Name="BufferingText"
                           Foreground="White"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>
        </Grid>

        <Grid x:Name="SettingsPanel" Padding="28" RowSpacing="20" MinWidth="480" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- 设备名称（文档 2.4：可随时修改，手机投屏列表里显示的就是它） -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="设备名称" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DeviceNameBox"
                         Grid.Column="0"
                         MaxLength="32"
                         PlaceholderText="例如：客厅电脑"
                         TextChanged="OnDeviceNameTextChanged" />
                <Button x:Name="ApplyNameButton"
                        Grid.Column="1"
                        Content="保存"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnApplyNameClick" />
            </Grid>
            <TextBlock x:Name="NameHintText"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- 服务开关与状态 -->
        <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock Text="接收服务" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="ServiceToggle"
                              OnContent="已开启"
                              OffContent="已关闭"
                              Toggled="OnServiceToggled" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- 画质档位（文档 2.3）。它改的是手机按多大的分辨率编码屏幕，只影响
             下次连接 —— 尺寸是在应答 /info 时给出去的。 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="画质" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="QualityBox"
                      MinWidth="220"
                      SelectionChanged="OnQualityChanged">
                <ComboBoxItem Content="流畅（1920×1080）" />
                <ComboBoxItem Content="均衡（2560×1440）" />
                <ComboBoxItem Content="高清（3840×2160）" />
            </ComboBox>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Text="决定手机按多大的分辨率把屏幕编出来，桌面全屏看推荐「高清」。改动在手机下次连上时生效。" />
        </StackPanel>

        <!-- 本机信息：电视端待机页也要显示这些（文档 2.3） -->
        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock Text="本机信息" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="局域网地址：" />
                <Run x:Name="AddressRun" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="设备标识：" />
                <Run x:Name="DeviceIdRun" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="核心版本：" />
                <Run x:Name="VersionRun" />
            </TextBlock>
        </StackPanel>

        <!-- 日志不画在页面里，改成一个独立的窗口（见 LogWindow.xaml）。 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
            <Button x:Name="ShowLogButtonSettings"
                    Content="查看日志"
                    Click="OnShowLogClick" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="日志在单独的窗口里显示，投屏时也能一直开着。" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
